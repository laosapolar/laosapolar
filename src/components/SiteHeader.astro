---
import Brand from './Brand.astro';
import { navigation } from '../data/site';
---
<header class="site-header">
  <div class="header-inner container">
    <Brand />
    <details class="navigation-shell" id="site-menu" open>
      <summary class="menu-toggle"><span class="menu-label">Menú</span><span class="menu-icon" aria-hidden="true"></span></summary>
      <nav aria-label="Navegación principal" id="main-navigation">
        <ul class="nav-list">
          {navigation.map(item => <li>
            {item.children ? <details class="nav-group">
              <summary>{item.label}<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="m2 4 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></summary>
              <ul class="submenu">{item.children.map(child => <li><a href={child.href}>{child.label}</a></li>)}</ul>
            </details> : <a href={item.href} aria-current={item.href === Astro.url.pathname ? 'page' : undefined}>{item.label}</a>}
          </li>)}
          <li class="contact-nav"><a href="/#contacto">Contacto</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { position: relative; z-index: 20; background: var(--paper); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); min-height: var(--header-height); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .menu-toggle { display: none; }
  .navigation-shell:not([open]) > nav { display: block; }
  .nav-list, .submenu { list-style: none; padding: 0; }
  .nav-list { display: flex; align-items: center; gap: clamp(.9rem, 1.7vw, 1.75rem); }
  .nav-list > li > a, .nav-group > summary { display: flex; align-items: center; gap: .4rem; min-height: 48px; font-size: .875rem; font-weight: 500; text-decoration: none; }
  .nav-list a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .55em; }
  .nav-group { position: relative; }
  .nav-group[open] > summary { color: var(--accent); }
  .nav-group[open] > summary svg { transform: rotate(180deg); }
  .submenu { position: absolute; top: calc(100% + .5rem); right: 0; width: 280px; background: var(--paper); border: 1px solid var(--line); padding: var(--space-3); }
  .submenu a { display: block; padding: .75rem; text-decoration: none; font-size: var(--text-small); line-height: 1.5; }
  .submenu a:hover, .submenu a:focus-visible { background: var(--wash); }
  .contact-nav a { color: var(--accent); }
  @media (max-width: 1120px) {
    .header-inner { flex-wrap: wrap; gap: 0; }
    .navigation-shell { margin-left: auto; }
    .menu-toggle { display: flex; align-items: center; justify-content: flex-end; gap: .7rem; min-height: 48px; min-width: 80px; font-size: .9375rem; }
    .menu-icon { width: 20px; height: 12px; border-block: 1px solid currentColor; }
    .navigation-shell[open] .menu-icon { height: 0; border-bottom: 0; transform: rotate(-45deg); }
    .navigation-shell[open] .menu-icon::after { content: ''; display: block; width: 20px; border-top: 1px solid currentColor; transform: rotate(90deg); }
    .navigation-shell:not([open]) > nav { display: none; }
    nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--paper); padding: var(--space-4) var(--gutter) var(--space-6); border-bottom: 1px solid var(--line); max-height: calc(100dvh - var(--header-height)); overflow-y: auto; }
    .nav-list { display: block; max-width: var(--container); margin-inline: auto; }
    .nav-list > li { border-bottom: 1px solid var(--line); }
    .nav-list > li > a, .nav-group > summary { min-height: 54px; font-size: 1rem; justify-content: space-between; }
    .submenu { position: static; width: auto; border: 0; border-left: 2px solid var(--accent); margin-bottom: var(--space-4); padding: 0 var(--space-3); }
  }
</style>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#site-menu');
  const toggle = menu?.querySelector<HTMLElement>(':scope > summary');
  const groups = [...document.querySelectorAll<HTMLDetailsElement>('.nav-group')];
  const desktop = matchMedia('(min-width: 1121px)');
  const resetMenu = () => { if (menu) menu.open = desktop.matches; };
  resetMenu();
  const closeGroups = () => groups.forEach(group => { group.open = false; });
  menu?.addEventListener('toggle', () => {
    toggle?.setAttribute('aria-expanded', String(menu.open));
    const label = toggle?.querySelector('.menu-label');
    if (label) label.textContent = menu.open ? 'Cerrar' : 'Menú';
    if (!menu.open) closeGroups();
  });
  toggle?.setAttribute('aria-controls', 'main-navigation');
  toggle?.setAttribute('aria-expanded', 'false');
  groups.forEach(group => group.addEventListener('toggle', () => {
    if (group.open) groups.filter(other => other !== group).forEach(other => { other.open = false; });
  }));
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const activeGroup = groups.find(group => group.open);
    if (activeGroup) { activeGroup.open = false; activeGroup.querySelector('summary')?.focus(); }
    else if (menu?.open && !desktop.matches) { menu.open = false; toggle?.focus(); }
  });
  document.addEventListener('click', event => {
    if (!(event.target instanceof Node)) return;
    if (!menu?.contains(event.target)) { closeGroups(); resetMenu(); }
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { closeGroups(); resetMenu(); }));
  desktop.addEventListener('change', () => { resetMenu(); closeGroups(); });
</script>
