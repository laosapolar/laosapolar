---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
interface Props { image: ImageMetadata; label: string; href: string; variant?: 'school' | 'proposal'; note?: string; }
const { image, label, href, variant = 'school', note } = Astro.props;
---
<a class:list={['illustrated-link', variant]} href={href}>
  <div class="illustration"><Image src={image} alt="" widths={[280, 420, 600]} sizes="(max-width: 600px) 45vw, (max-width: 900px) 42vw, 280px" loading="lazy" /></div>
  <div class="link-caption"><h3>{label}</h3><Arrow /></div>
  {note && <span class="note">{note}</span>}
</a>
<style>
  .illustrated-link { display: block; min-width: 0; text-decoration: none; }
  .illustration { margin-bottom: var(--space-5); }
  .illustration img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; mix-blend-mode: multiply; }
  .link-caption { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  .link-caption :global(svg) { flex-shrink: 0; align-self: center; }
  h3 { min-width: 0; overflow-wrap: anywhere; font-size: 1.125rem; line-height: 1.45; }
  .illustrated-link:hover h3 { text-decoration: underline; text-underline-offset: .25em; }
  .proposal .illustration { padding: var(--space-3); }
  .proposal .illustration img { aspect-ratio: 1 / 1.12; object-fit: contain; }
  .proposal .link-caption { padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .proposal h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.3; }
  .note { display: block; font-size: var(--text-small); color: var(--muted); margin-top: var(--space-3); }
  @media (max-width: 480px) { .proposal .illustration { max-width: 250px; margin-inline: auto; } }
  @media (max-width: 600px) { .link-caption { gap: var(--space-2); } h3 { font-size: 1rem; } .link-caption :global(svg) { width: 16px; } .illustration { margin-bottom: var(--space-4); } }
</style>
