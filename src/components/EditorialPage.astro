---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import MailForm from './MailForm.astro';
interface Props { page: { slug: string; title: string; description: string; html: string; imageCount: number }; }
const { page } = Astro.props;
const archive = ['especializacion','monograficos','informacion-postgrado','ciclo-esencial-2024'].includes(page.slug);
const empty = ['eventos','educacion-emocional-sanitaria'].includes(page.slug);
const contact = ['arteterapia-esencial','ciclo-esencial-2024','arteterapia-gestalt','espacio-individual','especializacion','monograficos','informacion-postgrado'].includes(page.slug);
const gallery = ['galeria','artistas-vida-y-obras','colaboraciones'].includes(page.slug);
const profile = !gallery && page.imageCount <= 2 && !contact && !['nosotras','la-osa-polar'].includes(page.slug);
const description = page.description || `${page.title}, La Osa Polar.`;
const metadataTitle = archive ? `${page.title} — Archivo — La Osa Polar` : `${page.title} — La Osa Polar`;
---
<Layout title={metadataTitle} {description} noindex={empty}>
  {archive && <div class="archive-banner"><div class="container">Convocatoria anterior conservada como archivo. Consulta la edición vigente o escríbenos para conocer próximas fechas.</div></div>}
  <PageHero title={page.title} {archive} />
  <article class:list={['editorial section', { gallery, profile, empty }]}>
    <div class="container article-grid">
      <div class="original-content" set:html={page.html} />
      {contact && <aside class="contact-panel" aria-labelledby={`${page.slug}-contact`}>
        <p class="eyebrow">Información</p><h2 id={`${page.slug}-contact`}>Escríbenos</h2><MailForm />
      </aside>}
      {empty && <aside class="status"><p>Esta página está en actualización.</p><a class="text-link" href="mailto:elmardelaosapolar@gmail.com">elmardelaosapolar@gmail.com</a></aside>}
    </div>
  </article>
</Layout>
<style>
  .archive-banner { background: var(--wash); border-bottom: 1px solid var(--line); padding-block: var(--space-4); font-size: var(--text-small); }
  .article-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .original-content { min-width: 0; max-width: 760px; font-size: 1.05rem; }
  .original-content :global(*) { max-width: 100%; overflow-wrap: anywhere; }
  .original-content :global(p), .original-content :global(ul), .original-content :global(ol), .original-content :global(blockquote) { margin-bottom: var(--space-5); }
  .original-content :global(h2), .original-content :global(h3), .original-content :global(h4) { margin: var(--space-7) 0 var(--space-4); }
  .original-content :global(h2) { font-size: clamp(2rem, 4vw, 3rem); }
  .original-content :global(h3) { font-size: clamp(1.3rem, 2.5vw, 1.75rem); }
  .original-content :global(ul), .original-content :global(ol) { padding-left: 1.35rem; }
  .original-content :global(li + li) { margin-top: var(--space-3); }
  .original-content :global(figure) { margin: var(--space-7) 0; }
  .original-content :global(img) { display: block; width: 100%; max-height: 760px; object-fit: contain; background: var(--white); }
  .original-content :global(figcaption) { margin-top: var(--space-3); color: var(--muted); font-size: var(--text-small); }
  .original-content :global(blockquote) { border-left: 2px solid var(--accent); padding-left: var(--space-5); font: 1.35rem/1.6 var(--font-quote); }
  .contact-panel { position: sticky; top: var(--space-5); border-top: 2px solid var(--accent); padding-top: var(--space-5); }
  .contact-panel h2 { margin-bottom: var(--space-6); }
  .status { border-left: 2px solid var(--accent); padding-left: var(--space-5); }
  .gallery .article-grid { display: block; }
  .gallery .original-content { max-width: none; columns: 3 280px; column-gap: var(--space-6); }
  .gallery .original-content :global(figure) { break-inside: avoid; display: inline-block; width: 100%; margin: 0 0 var(--space-6); }
  .gallery .original-content :global(p) { break-after: avoid; color: var(--accent); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .gallery .original-content :global(h2), .gallery .original-content :global(h3) { break-after: avoid; margin-top: 0; font-size: 1.25rem; }
  .gallery .original-content :global(img) { max-height: none; aspect-ratio: 4 / 3; object-fit: cover; }
  .profile .article-grid { display: block; }
  .profile .original-content { margin-inline: auto; }
  .profile .original-content :global(figure:first-child) { max-width: 520px; margin-inline: auto; }
  .profile .original-content :global(p) { max-width: 68ch; margin-inline: auto; }
  @media (max-width: 850px) { .article-grid { grid-template-columns: 1fr; } .contact-panel { position: static; } }
  @media (max-width: 520px) { .original-content { font-size: 1rem; } .gallery .original-content { columns: 1; } }
</style>
