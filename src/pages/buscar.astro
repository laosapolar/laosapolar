---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import pages from '../data/migrated-pages.json';
const index = pages.filter(page => !['inicio','eventos','formacion-1','antonio-castillo'].includes(page.slug)).map(({slug,title,description}) => ({slug,title,description}));
---
<Layout title="Buscar — La Osa Polar" description="Busca contenidos de La Osa Polar." noindex>
  <PageHero title="Buscar" />
  <section class="section"><div class="container search-wrap">
    <form class="search-form" role="search"><label for="site-search">¿Qué buscas?</label><div><input id="site-search" name="s" type="search" autocomplete="off" /><button class="button" type="submit">Buscar</button></div></form>
    <p id="search-summary" aria-live="polite"></p><ul id="search-results"></ul>
  </div></section>
  <script type="application/json" id="search-index" set:html={JSON.stringify(index)} />
</Layout>
<style>
  .search-wrap { max-width: 820px; } label { display: block; margin-bottom: var(--space-3); font-weight: 600; }
  .search-form > div { display: flex; gap: var(--space-3); } input { flex: 1; min-width: 0; border: 1px solid #909e95; border-radius: 0; padding: .75rem; font-size: 1rem; }
  #search-summary { margin: var(--space-6) 0; color: var(--muted); } ul { list-style: none; padding: 0; }
  li { border-top: 1px solid var(--line); padding-block: var(--space-5); } li a { font-size: 1.25rem; font-weight: 600; } li p { margin-top: var(--space-2); color: var(--muted); }
  @media(max-width:480px){ .search-form > div { align-items: stretch; flex-direction: column; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('.search-form');
  const input = document.querySelector<HTMLInputElement>('#site-search');
  const list = document.querySelector<HTMLUListElement>('#search-results');
  const summary = document.querySelector<HTMLElement>('#search-summary');
  const data = JSON.parse(document.querySelector('#search-index')?.textContent || '[]');
  const render = () => {
    const query = (input?.value || '').trim().toLocaleLowerCase('es');
    const matches = query ? data.filter((p: any) => `${p.title} ${p.description}`.toLocaleLowerCase('es').includes(query)) : [];
    if (summary) summary.textContent = query ? `${matches.length} resultado${matches.length === 1 ? '' : 's'} para “${input?.value.trim()}”.` : 'Escribe una palabra o un nombre para buscar.';
    if (list) { list.replaceChildren(...matches.map((p: any) => { const li=document.createElement('li'),a=document.createElement('a'),desc=document.createElement('p'); a.href=`/${p.slug}/`;a.textContent=p.title;desc.textContent=p.description;li.append(a,desc);return li; })); }
    const url = new URL(location.href); query ? url.searchParams.set('s', input?.value.trim() || '') : url.searchParams.delete('s'); history.replaceState({},'',url);
  };
  form?.addEventListener('submit', e => { e.preventDefault(); render(); });
  if (input) input.value = new URLSearchParams(location.search).get('s') || '';
  render();
</script>
